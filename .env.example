# Copy to .env (repo root) and fill in. Docker Compose reads it automatically via infra/docker-compose.yml.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# Public URL users open. The API is served under $FRONTEND_URL/api (Vite proxy in dev).
FRONTEND_URL=http://localhost:5173

# --- Database / Redis (defaults match docker-compose) ---
POSTGRES_USER=librachieve
POSTGRES_PASSWORD=librachieve
POSTGRES_DB=librachieve
DATABASE_URL=postgresql+asyncpg://librachieve:librachieve@postgres:5432/librachieve
REDIS_URL=redis://redis:6379/0

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Steam (https://steamcommunity.com/dev/apikey) ---
STEAM_API_KEY=

# --- IGDB (Twitch app: https://dev.twitch.tv/console/apps) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
